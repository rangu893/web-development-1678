
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LearnHub - E-Learning Website</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #222;
}

/* Navigation */
header {
    background: #172554;
    color: white;
    padding: 18px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 25px;
    color: #38bdf8;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    transition: 0.3s;
}

nav a:hover {
    color: #38bdf8;
}

/* Hero Section */
.hero {
    min-height: 380px;
    background: linear-gradient(120deg, #172554, #2563eb);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
    animation: fadeIn 1.5s;
}

.hero h1 {
    font-size: 45px;
    margin-bottom: 15px;
}

.hero span {
    color: #38bdf8;
}

.hero p {
    font-size: 18px;
    margin-bottom: 25px;
}

.btn {
    display: inline-block;
    background: #38bdf8;
    color: #172554;
    padding: 12px 25px;
    border: none;
    border-radius: 25px;
    text-decoration: none;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.btn:hover {
    background: white;
    transform: scale(1.05);
}

/* Common Sections */
section {
    padding: 60px 7%;
}

.title {
    text-align: center;
    font-size: 32px;
    color: #172554;
    margin-bottom: 30px;
}

/* Categories */
.categories {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

.category {
    background: white;
    padding: 18px 28px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #ddd;
    transition: 0.3s;
    cursor: pointer;
}

.category:hover {
    background: #2563eb;
    color: white;
    transform: translateY(-5px);
}

/* Course Cards */
.course-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
}

.course-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    transition: 0.4s;
}

.course-card:hover {
    transform: translateY(-10px);
}

.thumbnail {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
}

.course-content {
    padding: 20px;
}

.course-content h3 {
    color: #172554;
    margin-bottom: 10px;
}

.course-content p {
    color: #555;
    margin-bottom: 12px;
    font-size: 14px;
}

.instructor {
    color: #2563eb;
    font-weight: bold;
}

.course-btn {
    display: block;
    text-align: center;
    margin-top: 15px;
    background: #2563eb;
    color: white;
    padding: 10px;
    border-radius: 8px;
    text-decoration: none;
    transition: 0.3s;
}

.course-btn:hover {
    background: #172554;
}

/* Learning Objectives */
.objectives {
    background: #eaf2ff;
}

.objectives ul {
    max-width: 650px;
    margin: auto;
    line-height: 2.2;
}

/* Instructor Profiles */
.instructor-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

.teacher {
    text-align: center;
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 4px 12px #ddd;
    transition: 0.3s;
}

.teacher:hover {
    transform: scale(1.04);
}

.teacher img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 15px;
}

.teacher h3 {
    color: #172554;
}

/* Progress */
.progress-section {
    background: #eaf2ff;
}

.progress-card {
    background: white;
    padding: 25px;
    margin: 15px auto;
    max-width: 650px;
    border-radius: 12px;
}

.progress-bar {
    width: 100%;
    height: 13px;
    background: #ddd;
    border-radius: 20px;
    margin-top: 10px;
    overflow: hidden;
}

.progress-bar span {
    display: block;
    height: 100%;
    background: #2563eb;
    border-radius: 20px;
    animation: grow 2s ease;
}

/* Enrollment */
.enroll {
    text-align: center;
    background: #172554;
    color: white;
}

.enroll h2 {
    margin-bottom: 15px;
}

.enroll p {
    margin-bottom: 20px;
}

/* Footer */
footer {
    background: #0f172a;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Animations */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes grow {
    from { width: 0; }
}

/* Responsive Design */
@media(max-width: 768px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    nav a {
        margin: 0;
        font-size: 14px;
    }

    .hero h1 {
        font-size: 32px;
    }

    .hero p {
        font-size: 15px;
    }

    section {
        padding: 45px 5%;
    }
}
</style>
</head>

<body>

<!-- Navigation -->
