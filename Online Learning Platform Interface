    <ul>
        <li>Understand basic programming concepts.</li>
        <li>Develop responsive websites using HTML and CSS.</li>
        <li>Understand Artificial Intelligence applications.</li>
        <li>Improve problem-solving and logical thinking.</li>
        <li>Develop creative and technical skills.</li>
    </ul>
</section>

<!-- Instructors -->
<section id="instructors">
    <h2 class="title">Our Instructors</h2>

    <div class="instructor-container">

        <div class="teacher">
            <img src="https://i.pravatar.cc/150?img=12"
