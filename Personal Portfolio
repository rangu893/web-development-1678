
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Personal Portfolio</title>

<style>
/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fc;
    color: #222;
    line-height: 1.6;
}

/* Navigation Bar */
header {
    background: #101d3a;
    color: white;
    padding: 18px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
}

header h2 {
    color: #00d4ff;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    transition: 0.3s;
}

nav a:hover {
    color: #00d4ff;
    border-bottom: 2px solid #00d4ff;
    padding-bottom: 5px;
}

/* Hero Section */
.hero {
    min-height: 90vh;
    background: linear-gradient(135deg, #101d3a, #174b79);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px;
    animation: fadeIn 1.5s ease;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 10px;
}

.hero h1 span {
    color: #00d4ff;
}

.hero p {
    font-size: 20px;
    margin-bottom: 25px;
}

.btn {
    display: inline-block;
    background: #00d4ff;
    color: #101d3a;
    padding: 12px 25px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    background: white;
    transform: scale(1.08);
}

/* Common Sections */
section {
    padding: 70px 8%;
}

.section-title {
    text-align: center;
    font-size: 32px;
    color: #174b79;
    margin-bottom: 35px;
}

/* Profile */
.profile {
    text-align: center;
}

.profile p {
    max-width: 750px;
    margin: auto;
}

/* Cards */
.container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 22px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    transition: 0.4s;
    animation: slideUp 1s ease;
}

.card:hover {
    transform: translateY(-10px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

.card h3 {
    color: #174b79;
    margin-bottom: 12px;
}

/* Skills */
.skill {
    margin-bottom: 20px;
}

.skill p {
    font-weight: bold;
}

.progress {
    height: 10px;
    background: #ddd;
    border-radius: 10px;
    overflow: hidden;
}

.progress span {
    display: block;
    height: 100%;
    background: #00a8cc;
    animation: grow 2s ease;
}

/* Hobbies */
.hobbies {
    text-align: center;
}

.hobby {
    display: inline-block;
    background: white;
    padding: 15px 25px;
    margin: 10px;
    border-radius: 20px;
    box-shadow: 0 3px 10px #ddd;
    transition: 0.3s;
}

.hobby:hover {
    background: #174b79;
    color: white;
    transform: scale(1.1);
}

/* Resume */
.resume {
    text-align: center;
    background: #e5f4ff;
}

/* Contact */
.contact {
    text-align: center;
}

.contact a {
    color: #174b79;
    text-decoration: none;
}

.contact a:hover {
    color: #00a8cc;
}

/* Footer */
footer {
    background: #101d3a;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Animations */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes grow {
    from { width: 0; }
}

/* Mobile Responsive Design */
@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 12px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    nav a {
        margin: 0;
        font-size: 14px;
    }

    .hero h1 {
        font-size: 34px;
    }

    .hero p {
        font-size: 16px;
    }

    section {
        padding: 50px 6%;
    }
}
</style>
</head>

<body>

